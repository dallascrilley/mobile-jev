# Server-side cloud credentials. Leave blank for local ADB + Rizzo mode.
# Do not expose these values through NEXT_PUBLIC_* variables.
# Create a key at https://cloud.mobilerun.ai/api-keys
MOBILERUN_API_KEY=

# Cloud mode only: set MOBILE_DEVICE_BACKEND=mobilerun and use your own device ID.
MOBILERUN_DEVICE_ID=
MOBILERUN_BASE_URL=https://api.mobilerun.ai/v1
# Faster input acknowledgements, with exact local read-back before the next action.
# Set committed to retain the server-side completion wait for all text input.
MOBILERUN_TEXT_COMPLETION_MODE=accepted

# Server-side Jev credential. Rizzo and TEV-1 do not use this key.
# Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional 1Password field reference for runtime-only injection.
TYPESAFE_CREDENTIAL_REFERENCE=
TYPESAFE_MODEL=jev-1.13.0

# Select local, ios, or mobilerun. Local mode uses ADB; ios uses supervised WDA.
MOBILE_DEVICE_BACKEND=local
ADB_SERIAL=
# Stable physical-device identity shared by every local device client and benchmark worker.
AGENT_DEVICE_IDENTITY=
# Optional override for the shared device-lock directory.
# AGENT_DEVICE_LOCK_ROOT=

# Decision provider: jev, rizzo, or tev1. Jev is the studio default.
# Rizzo's local endpoint is 127.0.0.1:18094. Jev requires TYPESAFE_API_KEY.
DECISION_BACKEND=jev

# Loopback ports for the local service and studio.
DEVICE_SERVICE_PORT=3041
STUDIO_PORT=3040

# iOS mode requires one explicit device and its supervised endpoint binding.
# Use a separate LaunchAgent/config file per iPhone or iPad; do not reuse Android's identity.
# IOS_DEVICE_UDID=
# IOS_DEVICE_NAME=
# IOS_WDA_URL=http://127.0.0.1:18100
# IOS_WDA_BINDING_FILE=/absolute/private/runtime/binding.json
# IOS_WDA_SESSION_ID=
# IOS_WDA_BUILD_DIR=/absolute/path/to/Build/Products
# IOS_WDA_SOURCE_REVISION=381e75ce6ad1afb97b46cc3aa72e758193af1353
# DEVICE_SERVICE_PORT=3042
# STUDIO_PORT=3044

# Optional absolute path to a host recovery executable exposed by the local service.
# TABLET_RECOVER_BIN=
